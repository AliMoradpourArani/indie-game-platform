// Prisma schema — authoritative DB model. See docs/DATABASE.md.
// Game binaries live in file storage; only metadata (storageKey, size, hash) here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  DEVELOPER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum SubmissionState {
  DRAFT
  PENDING_REVIEW
  UNDER_REVIEW
  APPROVED
  CHANGES_REQUIRED
  REJECTED
  PUBLISHED
}

enum ReviewDecision {
  APPROVED
  CHANGES_REQUIRED
  REJECTED
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum BuildPlatform {
  WINDOWS
  LINUX
  MAC
  WEB
}

enum MediaKind {
  COVER
  SCREENSHOT
  TRAILER
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         Role       @default(PLAYER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())

  profile          Profile?
  developerProfile DeveloperProfile?
  games            Game[]            @relation("DeveloperGames")
  submissions      Submission[]      @relation("SubmittedBy")
  reviewsGiven     Review[]          @relation("Reviewer")
  purchases        Purchase[]
  entitlements     Entitlement[]
  downloadTokens   DownloadToken[]
  auditActions     AuditLog[]        @relation("Actor")
}

model Profile {
  userId      String  @id
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  avatarKey   String?
  bio         String?
  locale      String  @default("en")
  theme       String  @default("system")
}

model DeveloperProfile {
  userId     String  @id
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  studioName String
  website    String?
  verified   Boolean @default(false)
}

model Game {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  genre       String
  tags        String[] @default([])
  priceCents  Int      @default(0)
  currency    String   @default("USD")
  coverKey    String?
  developerId String
  developer   User     @relation("DeveloperGames", fields: [developerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions     GameVersion[]
  media        GameMedia[]
  submissions  Submission[]
  purchases    Purchase[]
  entitlements Entitlement[]

  @@index([genre])
  @@index([developerId])
}

model GameVersion {
  id           String   @id @default(cuid())
  gameId       String
  game         Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  version      String
  changelog    String   @default("")
  requirements Json?
  createdAt    DateTime @default(now())

  builds      GameBuild[]
  submissions Submission[]

  @@unique([gameId, version])
}

model GameBuild {
  id         String        @id @default(cuid())
  versionId  String
  version    GameVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  platform   BuildPlatform
  storageKey String        @unique
  sizeBytes  BigInt
  sha256     String
  demo       Boolean       @default(false)
  createdAt  DateTime      @default(now())

  downloadTokens DownloadToken[]

  @@unique([versionId, platform, demo])
}

model GameMedia {
  id         String    @id @default(cuid())
  gameId     String
  game       Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  kind       MediaKind
  storageKey String
  sortOrder  Int       @default(0)
}

model Submission {
  id          String          @id @default(cuid())
  gameId      String
  game        Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)
  versionId   String
  version     GameVersion     @relation(fields: [versionId], references: [id])
  state       SubmissionState @default(DRAFT)
  submittedBy String
  submitter   User            @relation("SubmittedBy", fields: [submittedBy], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  reviews Review[]

  @@index([state])
}

model Review {
  id           String         @id @default(cuid())
  submissionId String
  submission   Submission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewer     User           @relation("Reviewer", fields: [reviewerId], references: [id])
  decision     ReviewDecision
  comment      String
  createdAt    DateTime       @default(now())
}

model Purchase {
  id             String         @id @default(cuid())
  buyerId        String
  buyer          User           @relation(fields: [buyerId], references: [id])
  gameId         String
  game           Game           @relation(fields: [gameId], references: [id])
  amountCents    Int
  currency       String         @default("USD")
  status         PurchaseStatus @default(PENDING)
  providerRef    String?        @unique
  idempotencyKey String         @unique
  createdAt      DateTime       @default(now())

  entitlements Entitlement[]
}

model Entitlement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId     String
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  grantedAt  DateTime @default(now())

  @@unique([userId, gameId])
}

model DownloadToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  buildId   String
  build     GameBuild @relation(fields: [buildId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("Actor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  diff       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}
