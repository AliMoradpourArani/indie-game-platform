# Database URL for local dev (docker-compose default). Never commit real credentials.
DATABASE_URL="postgresql://indie:indie_dev_password@localhost:5432/indie_game_platform?schema=public"
# Backend
PORT=4000
JWT_SECRET="dev-only-change-me-min-32-chars-please"
JWT_EXPIRES_IN="7d"
# Local storage root (relative to backend/)
STORAGE_ROOT="./storage"
STORAGE_BASE_URL="/files"
# Seed accounts (dev only)
SEED_ADMIN_EMAIL="admin@local.test"
SEED_ADMIN_PASSWORD="Admin1234!"
SEED_DEV_EMAIL="dev@local.test"
SEED_DEV_PASSWORD="Dev1234!"
SEED_PLAYER_EMAIL="player@local.test"
SEED_PLAYER_PASSWORD="Player1234!"
